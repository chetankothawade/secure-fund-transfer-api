{
  "openapi": "3.1.0",
  "info": {
    "title": "Secure Fund Transfer API",
    "version": "1.0.0",
    "description": "API for transferring funds between accounts with API key authentication, Redis idempotency, Redis-backed rate limiting, RFC 7807 errors, and MySQL transaction integrity."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Docker/local development"
    },
    {
      "url": "http://127.0.0.1:8080",
      "description": "Local PHP server"
    }
  ],
  "paths": {
    "/transfers": {
      "post": {
        "summary": "Transfer funds between accounts",
        "description": "Creates a transfer. Requests are limited to 30 per minute per authenticated user key. Reusing an idempotency key returns the original transaction ID without processing the transfer again.",
        "operationId": "createTransfer",
        "parameters": [
          {
            "name": "X-Api-Key",
            "in": "header",
            "required": true,
            "description": "Shared API key configured with TRANSFER_API_KEY.",
            "schema": {
              "type": "string",
              "example": "demo-transfer-api-key"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique request key stored in Redis for 24 hours.",
            "schema": {
              "type": "string",
              "example": "demo-transfer-1"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "description": "Demo user key used by the local rate limiter when real authentication is not present.",
            "schema": {
              "type": "string",
              "example": "demo-user-1"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferRequest"
              },
              "example": {
                "from_account_id": "11111111-1111-1111-1111-111111111111",
                "to_account_id": "22222222-2222-2222-2222-222222222222",
                "amount": 25.5,
                "currency": "USD"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfer created, or an existing idempotent transaction ID returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                },
                "example": {
                  "transaction_id": "33333333-3333-3333-3333-333333333333"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/UnprocessableEntity"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/accounts/{id}": {
      "get": {
        "summary": "Read account details",
        "operationId": "getAccount",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "11111111-1111-1111-1111-111111111111"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/accounts/{id}/balance": {
      "get": {
        "summary": "Read account balance",
        "operationId": "getAccountBalance",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "11111111-1111-1111-1111-111111111111"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current account balance.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Balance"
                },
                "example": {
                  "balance": "1000.0000",
                  "currency": "USD"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransferRequest": {
        "type": "object",
        "required": [
          "from_account_id",
          "to_account_id",
          "amount",
          "currency"
        ],
        "properties": {
          "from_account_id": {
            "type": "string",
            "format": "uuid",
            "example": "11111111-1111-1111-1111-111111111111"
          },
          "to_account_id": {
            "type": "string",
            "format": "uuid",
            "example": "22222222-2222-2222-2222-222222222222"
          },
          "amount": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\d+(?:\\.\\d{1,4})?$"
              },
              {
                "type": "number"
              }
            ],
            "exclusiveMinimum": 0,
            "example": "25.5000"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code.",
            "minLength": 3,
            "maxLength": 3,
            "example": "USD"
          }
        }
      },
      "TransferResponse": {
        "type": "object",
        "required": [
          "transaction_id"
        ],
        "properties": {
          "transaction_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "id",
          "owner_name",
          "balance",
          "currency",
          "version",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "owner_name": {
            "type": "string",
            "example": "Alice"
          },
          "balance": {
            "type": "string",
            "example": "1000.0000"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          },
          "version": {
            "type": "integer",
            "example": 1
          },
          "created_at": {
            "type": "string",
            "example": "2026-05-27 10:00:00"
          }
        }
      },
      "Balance": {
        "type": "object",
        "required": [
          "balance",
          "currency"
        ],
        "properties": {
          "balance": {
            "type": "string",
            "example": "1000.0000"
          },
          "currency": {
            "type": "string",
            "example": "USD"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com/problems/validation-error"
          },
          "title": {
            "type": "string",
            "example": "Invalid request body"
          },
          "status": {
            "type": "integer",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "One or more request fields failed validation."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "example": "from_account_id"
                },
                "message": {
                  "type": "string",
                  "example": "This is not a valid UUID."
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid JSON, invalid request payload, or invalid request rule.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "Conflict while processing request, including insufficient funds or duplicate in-progress idempotency key.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Domain rule failed, such as currency mismatch.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Transfer rate limit exceeded.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server error.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}
