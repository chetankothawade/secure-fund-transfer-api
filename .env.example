APP_ENV=prod
APP_SECRET=change-me-to-a-long-random-secret
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8080

MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=transfer_db
MYSQL_USER=transfer_user
MYSQL_PASSWORD=change-app-password

# Docker Compose service URLs:
DATABASE_URL="mysql://transfer_user:change-app-password@mysql:3306/transfer_db?serverVersion=8.0.32&charset=utf8mb4"
REDIS_URL=redis://redis:6379

# Local non-Docker examples:
# DATABASE_URL="mysql://root:@127.0.0.1:3306/transfer_db?serverVersion=8.0.32&charset=utf8mb4"
# REDIS_URL=redis://127.0.0.1:6379
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
